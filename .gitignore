# ==========================================
# Open-LLM-VTuber Security & Ignore Rules
# ==========================================

# Secrets, Environment Variables & API Keys
.env
.env.*
*.env
*.key
*.pem
*.crt
*.pfx
api_keys.py
user_credentials.json
src/open_llm_vtuber/llm/user_credentials.json
mcp_servers.json

# User Configurations & Backups
conf.yaml.backup*
conf*.backup
*.bak
*.swp

# Executables & Tunnels
*.exe
cloudflared.exe
ngrok.exe

# Logs, Databases & Temporary Files
*.log
logs/*
server.log
memory.db
memory.db.bk
mem.json
chat_history/
tmp/
temp/
scratch/
private/

# Audio & Media Caches
cache/*
assets/faq_audio/*.bak
!cache/README.md

# Models, Weights & Downloads
models/*
!models/README.md
!models/piper_voice
models/piper_voice/*
src/open_llm_vtuber/tts/asset
src/open_llm_vtuber/tts/config
src/open_llm_vtuber/asr/models*
!src/open_llm_vtuber/asr/models/silero_vad.onnx

# Custom Character Assets & Backgrounds
/backgrounds/*
!/backgrounds/README.md
!/backgrounds/*.jpeg
!/backgrounds/*.jpg
!/backgrounds/*.png
/live2d-models/*
!/live2d-models/mao_pro
!/live2d-models/shizuku
/characters/*
!/characters/README.md
avatars/*

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.conda/
conda/
.pytest_cache/

# IDE & Operating System Files
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.suo
*.user